{
  "$schema": "aicoe-design-system/tokens v1.0",
  "meta": {
    "name": "AICOE Design System",
    "version": "1.0.0",
    "theme": "light-only",
    "source": "ShiftAI Marketing Studio"
  },
  "color": {
    "bg": "#ffffff",
    "surface": "#fafafa",
    "ink": "#1b1b20",
    "text": "#3f4046",
    "muted": "#66666e",
    "faint": "#f1f1f4",
    "line": "#e5e5ea",
    "lineSoft": "#efeff2",
    "brand": { "base": "#456bb6", "ink": "#34518d", "soft": "#e9eff9", "line": "#c8d6ef" },
    "accent": { "base": "#047857", "ink": "#065f46", "soft": "#e4f3ec" },
    "amber": { "ink": "#8a4a06", "soft": "#fbf0df", "line": "#ecd9b8", "live": "#d97706" },
    "red": { "base": "#b42318", "soft": "#fbeae8" },
    "chart": ["#456bb6", "#047857", "#b45309", "#db2777"]
  },
  "semantics": {
    "primaryAction": "brand",
    "agentOrInProgress": "brand",
    "humanGateOrWaiting": "amber",
    "successApprovedDone": "accent",
    "blockedOverdueDestructive": "red",
    "note": "Red is used sparingly: text buttons, chips and counters only. Never large fills."
  },
  "radius": { "panel": 12, "control": 8, "pill": 99, "menuItem": 7, "innerBox": 10 },
  "typography": {
    "fontSans": "\"Geist Variable\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "fontMono": "\"Geist Mono Variable\", ui-monospace, SFMono-Regular, Consolas, monospace",
    "npmFonts": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono"],
    "baseSize": 13,
    "lineHeight": 1.5,
    "floor": 11,
    "scale": {
      "h1": { "size": 21, "weight": 650, "letterSpacing": -0.4, "lineHeight": 1.2 },
      "h2": { "size": 15, "weight": 600, "letterSpacing": -0.1 },
      "h3": { "size": 13, "weight": 600 },
      "body": { "size": 13, "weight": 400 },
      "control": { "size": 12.5, "weight": 600 },
      "caption": { "size": 11.5, "weight": 400 },
      "micro": { "size": 11, "weight": 600 },
      "kpi": { "size": 19, "weight": 650, "letterSpacing": -0.3 }
    }
  },
  "layout": {
    "sidebarWidth": 224,
    "sidebarCollapsed": 68,
    "topbarHeight": 54,
    "contentMaxWidth": 1200,
    "contentPadding": "22px 28px 56px",
    "cardPadding": 16,
    "gridGap": 14,
    "breakpoints": { "tablet": 1080, "mobile": 760 }
  },
  "controls": {
    "buttonHeight": 32,
    "tallControlHeight": 34,
    "inputHeight": 32,
    "iconButton": 30,
    "navItemHeight": 34
  },
  "elevation": {
    "popover": "0 12px 32px rgba(23,23,28,0.10)",
    "panel": "0 16px 44px rgba(23,23,28,0.14)",
    "cardHover": "0 6px 20px rgba(27,27,32,0.06)",
    "toast": "0 10px 30px rgba(20,22,30,0.25)",
    "rule": "Borders over shadows. Shadows only on floating surfaces."
  },
  "motion": {
    "fast": "0.13s ease",
    "base": "0.15s ease",
    "layout": "0.18s ease",
    "reducedMotion": "All transitions and animations disabled under prefers-reduced-motion"
  },
  "iconography": {
    "library": "@phosphor-icons/react",
    "defaultWeight": "regular",
    "sizes": { "inline": 14, "control": 16, "feature": 20 }
  }
}
